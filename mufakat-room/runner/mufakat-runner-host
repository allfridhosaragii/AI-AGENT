#!/bin/sh
# Wrapper executable Local Runner MUFAKAT Room (audit H6, N9).
# Chrome menjalankan `path` di manifest native messaging dengan argumen
# `chrome-extension://<id>/` — wrapper ini yang memanggil host Python,
# BUKAN interpreter Python langsung (dulu path = sys.executable sehingga
# Python mencoba membuka file bernama chrome-extension://... dan keluar).
#
# N9: file ini HARUS executable (git update-index --chmod=+x
# mufakat-room/runner/mufakat-runner-host) dan TIDAK BOLEH memanggil
# `python3` sembarang dari PATH bila ada console script venv yang
# terpasang — urutan di bawah memakai venv dulu, `python3` hanya
# fallback terakhir.
if [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
  exec "$VIRTUAL_ENV/bin/python" -m mufakat_runner.host "$@"
fi
# Console script dari venv yang terpasang di PATH (bukan file ini sendiri).
SCRIPT=$(command -v mufakat-runner-host 2>/dev/null || true)
if [ -n "$SCRIPT" ] && [ "$SCRIPT" != "$0" ] && [ -x "$SCRIPT" ]; then
  exec "$SCRIPT" "$@"
fi
exec python3 -m mufakat_runner.host "$@"
