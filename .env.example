# MUFAKAT — contoh konfigurasi lingkungan. Salin ke .env dan isi kuncinya.
# JANGAN commit file .env yang sudah terisi ke repositori.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
META_API_KEY=
MUFAKAT_DB=
MUFAKAT_MAX_COST_USD=1.0
# Password docker-compose (M11): wajib diisi bila memakai compose.
# JANGAN pakai nilai default; isi password kuat.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Token autentikasi dashboard web bila dipakai publik (opsional).
# Bila kosong, web HANYA untuk lokal (local-only) tanpa auth.
MUFAKAT_WEB_TOKEN=
